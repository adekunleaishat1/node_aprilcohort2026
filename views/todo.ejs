<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <title>Document</title>
</head>
<body>
  <h1 class="text-center fs-3">Todo List</h1>
    
    <form class="w-50 mx-auto py-3 px-3 shadow" action="/user/addtodo/<%= name %>" method="post">
        <input name="title" class="form-control mt-3" type="text" placeholder="Enter Title...">
        <input name="description" class="form-control mt-3" type="text" placeholder="Enter Description...">
        <button class="btn btn-dark mt-3">Addtodo</button>
    </form> 
    
    <% alltodo.forEach(element => { %>
       <p><%= element.title %></p>
       <p><%= element.description %></p>
       <form action="/user/deletetodo/<%= element._id %>" method="post">
        <button class="btn btn-danger">delete</button>
       </form>
       
    <% }) %>
</body>
</html>